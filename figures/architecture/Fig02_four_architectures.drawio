          vertex="1" parent="1"><mxGeometry x="400" y="630" width="170" height="130" as="geometry"/></mxCell>
        <mxCell id="cHD" value="Shared subnets&#10;&#10;classification + box regression&#10;sigmoid focal loss&#10;&#947; = 2.0, &#945; = 0.25&#10;&#8594; 9 classes"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C9D9ED;strokeColor=#4472C4;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="600" y="620" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="cN" value="Shares its detection head, anchors and loss with RetinaNeXt, so the comparison isolates backbone, neck and attention"
