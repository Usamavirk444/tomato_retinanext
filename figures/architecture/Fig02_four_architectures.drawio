          vertex="1" parent="1"><mxGeometry x="1200" y="230" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="bHD" value="Decoupled head&#10;&#10;anchor-free&#10;separate class and box branches&#10;&#8594; 9 classes"
