                  math="0" shadow="0" background="#EFF2F7">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="t" value="Comparative architectures for tomato leaf disease detection"
          style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#1F1F1F;"
          vertex="1" parent="1"><mxGeometry x="320" y="16" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="t2" value="All four trained on the same nine-class benchmark at 640 &#215; 640 input, batch size 8, AdamW, 70 epochs"
          style="text;html=1;align=center;fontSize=13;fontColor=#555555;"
          vertex="1" parent="1"><mxGeometry x="320" y="52" width="1000" height="22" as="geometry"/></mxCell>

        <!-- ============ A. SSDLite ============ -->
        <mxCell id="pA" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;strokeWidth=2;"
          vertex="1" parent="1"><mxGeometry x="40" y="100" width="780" height="390" as="geometry"/></mxCell>
        <mxCell id="pAt" value="A&#160;&#160;SSDLite with MobileNetV3-Large&#160;&#160;&#183;&#160;&#160;2.3 M parameters&#160;&#183;&#160;48.4 FPS"
          style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#1F3864;"
          vertex="1" parent="1"><mxGeometry x="60" y="112" width="740" height="26" as="geometry"/></mxCell>

        <mxCell id="aIn" value="Input&#10;640&#215;640"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="66" y="250" width="86" height="76" as="geometry"/></mxCell>
        <mxCell id="aBB" value="MobileNetV3-Large&#10;&#10;inverted residual blocks&#10;Squeeze-and-Excitation&#10;hard-swish activations"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#284879;strokeColor=#1B3254;fontColor=#FFFFFF;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="180" y="210" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="aFM" value="Six feature scales&#10;hierarchical downsampling"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEBD4A;strokeColor=#A88A20;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="400" y="230" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="aHD" value="SSDLite prediction heads&#10;&#10;depth-wise separable convolutions&#10;softmax over preset anchors&#10;&#8594; 9 classes"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C9D9ED;strokeColor=#4472C4;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="600" y="210" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="aN" value="Lightweight baseline: the only model here with no feature-pyramid neck"
          style="text;html=1;align=center;fontSize=11;fontColor=#666666;fontStyle=2;"
          vertex="1" parent="1"><mxGeometry x="60" y="430" width="740" height="20" as="geometry"/></mxCell>

        <!-- ============ B. YOLOv8n ============ -->
        <mxCell id="pB" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;strokeWidth=2;"
          vertex="1" parent="1"><mxGeometry x="840" y="100" width="760" height="390" as="geometry"/></mxCell>
        <mxCell id="pBt" value="B&#160;&#160;YOLOv8n&#160;&#160;&#183;&#160;&#160;3.0 M parameters&#160;&#183;&#160;83.5 FPS"
          style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#1F3864;"
          vertex="1" parent="1"><mxGeometry x="860" y="112" width="720" height="26" as="geometry"/></mxCell>

        <mxCell id="bIn" value="Input&#10;640&#215;640"
