        <mxCell id="cBB" value="ResNet-50&#10;&#10;3&#215;3 bottleneck blocks&#10;C3 / C4 / C5&#10;512 / 1024 / 2048 ch"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#284879;strokeColor=#1B3254;fontColor=#FFFFFF;fontSize=11;"
          vertex="1" parent="1"><mxGeometry x="180" y="620" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="cNK" value="FPN&#10;&#10;top-down only&#10;lateral connections&#10;P3&#8211;P7, 256 ch"
