        <mxCell id="pCt" value="C&#160;&#160;RetinaNet-ResNet50-FPN-v2 &#8212; primary baseline&#160;&#160;&#183;&#160;&#160;36.5 M parameters&#160;&#183;&#160;32.3 FPS"
          style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#1F3864;"
          vertex="1" parent="1"><mxGeometry x="60" y="522" width="740" height="26" as="geometry"/></mxCell>

        <mxCell id="cIn" value="Input&#10;640&#215;640"
